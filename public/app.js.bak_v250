// 聖甲之心 安卓版流程：登入 → WS 換直連遊戲網址(跳過大廳) → InAppBrowser 開 → executeScript 注入引擎
// CapacitorHttp 已開 → fetch 走原生、繞 CORS。滿版 console.log → logcat 看得到(tag chromium CONSOLE)。
const $ = id => document.getElementById(id);
const UA = 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0.0.0 Safari/537.36';
const L = (...a) => { try { console.log('[SETH]', ...a); } catch (e) {} };
window.SETH_APP_VER = 'v2.37';   // App 版本(打包時與 engine BUILD_VER 對齊；錯誤記錄會帶上)★2026-08-12起改v2.xx序、每次改版+0.01
// 低調版本號填入登入頁(需提醒用戶才會注意；用戶截圖回報時帶上版本→我們知道他裝的是不是最新)
try { document.addEventListener('DOMContentLoaded', function () { document.querySelectorAll('.seth-ver').forEach(function (el) { el.textContent = window.SETH_APP_VER; }); }); } catch (e) {}
let session = null;

// ── 雷神(RSG)整合：遊戲商別判斷 ─────────────────────────────────────
// 雷神 option value = 'rsg-<gameId>'（如 rsg-129 二代）。isRSG 判前綴、rsgGameId 取數字 gameId。
// ATG 三款(golden-seth/egyptian-mythology/tiger-princess)不是 rsg- 前綴 → isRSG=false，走原選房流程。
const isRSG = (g) => String(g || '').startsWith('rsg-');
const rsgGameId = (g) => { const m = String(g || '').match(/^rsg-(\d+)$/); return m ? m[1] : null; };

// ★ 螢幕方向：遊戲是橫向設計，InAppBrowser 視窗不會自己轉 → 進遊戲前強制鎖橫向（不靠用戶轉），回選房/登入頁鎖直向
const ScreenOri = () => (window.Capacitor && window.Capacitor.Plugins && window.Capacitor.Plugins.ScreenOrientation);
async function lockLandscape() { try { const s = ScreenOri(); if (s) { await s.lock({ orientation: 'landscape' }); L('已鎖橫向'); } } catch (e) { L('鎖橫向失敗', e && e.message); } }
async function lockPortrait() { try { const s = ScreenOri(); if (s) { await s.lock({ orientation: 'portrait' }); L('已鎖直向'); } } catch (e) {} }
async function unlockOri() { try { const s = ScreenOri(); if (s) { await s.unlock(); L('已解除方向鎖→跟隨感應器'); } } catch (e) { L('解除方向鎖失敗', e && e.message); } }   // ★進房用：解除回選房時鎖的直向，否則第二次進房卡直向轉不回橫

// 聖甲之心助手「各房綜合分數」API（規格見 docs/cross-machine/聖甲之心助手API規格_自動選房.md）。
// 聖甲之心助手那邊開好後填網址+金鑰即生效；未開→fetch 失敗→引擎自動退回遊戲內得分率排序。
const SCORE_API = '';                 // 例：'https://member.seth-eye.com/api/copilot/room-scores'
const COPILOT_KEY = '';               // 跟聖甲之心助手端設同一把
function operatorCode(base) { return /gw1688/.test(base) ? 'gw1688' : /ofa/.test(base) ? 'ofa' : ''; }
async function fetchRoomScores(game, base) {
  if (!SCORE_API) { L('SCORE_API 未設 → 自動選房暫用遊戲內得分率'); return null; }
  try {
    const op = operatorCode(base);
    const url = SCORE_API + '?game=' + encodeURIComponent(game) + (op ? '&operator=' + op : '');
    const headers = { 'Accept': 'application/json' }; if (COPILOT_KEY) headers['X-Copilot-Key'] = COPILOT_KEY;
    const j = await (await fetch(url, { headers })).json();
    const map = {}; ((j && j.rooms) || []).forEach(x => { if (x && x.room != null) map[String(x.room).trim()] = +x.score || 0; });
    L('雷神分析分數', Object.keys(map).length, '房, updatedAt=' + (j && j.updatedAt));
    return Object.keys(map).length ? map : null;
  } catch (e) { L('取雷神分析分數失敗(退回遊戲內得分率)', e && e.message); return null; }
}

function deviceId() {
  let d = localStorage.getItem('seth_dev_id');
  if (!d) { d = 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, c => { const r = Math.floor(Math.random() * 16); return (c === 'x' ? r : (r & 0x3 | 0x8)).toString(16); }); localStorage.setItem('seth_dev_id', d); }
  return d;
}
async function postJson(url, body, token) {
  const headers = { 'Content-Type': 'application/json', 'User-Agent': UA, 'Origin': new URL(url).origin, 'Referer': new URL(url).origin + '/' };
  if (token) headers['Authorization'] = 'Bearer ' + token;
  // 手機：直接走原生 CapacitorHttp.request（fetch 層會 strip 掉 UA/Origin/Referer，娛樂城在 Cloudflare 後缺 UA 會吊死）。
  // 原生層不受 forbidden header 限制 → 強制帶 UA；加 timeout 避免永遠 hang。
  const CH = window.Capacitor && window.Capacitor.Plugins && window.Capacitor.Plugins.CapacitorHttp;
  if (CH) {
    L('原生CapHttp POST(帶UA)', url);
    const res = await CH.request({ url, method: 'POST', headers, data: body, dataType: 'json', connectTimeout: 15000, readTimeout: 15000 });
    L('CapHttp 回應 status=' + (res && res.status));
    if (res && res.status >= 400) { const err = new Error('伺服器回應 ' + res.status); err.status = res.status; throw err; }
    return res && res.data;
  }
  const r = await fetch(url, { method: 'POST', headers, body: JSON.stringify(body) });
  return r.json();
}

// WS 換直連遊戲網址（同桌面 directGameUrl，改用瀏覽器 WebSocket）
function directGameUrl(gt, code) {
  return new Promise((resolve, reject) => {
    let ws;
    try { ws = new WebSocket('wss://socket.godeebxp.com/socket.io/?EIO=3&transport=websocket'); }
    catch (e) { L('WS 建立失敗', e && e.message); return reject(e); }
    let ack = 0, tok = gt, initAck = -1, playAck = -1, done = false;
    const send = (name, data) => { const a = ack++; ws.send('42' + a + JSON.stringify([name, data])); return a; };
    const to = setTimeout(() => { if (!done) { try { ws.close(); } catch (e) {} L('WS 逾時'); reject(new Error('WS逾時')); } }, 20000);
    ws.onopen = () => L('WS 連上');
    ws.onmessage = (ev) => {
      const m = '' + ev.data;
      if (m === '2') { ws.send('3'); return; }
      if (m === '40') { initAck = send('lobbyInitial', { token: gt, clientType: 'web' }); return; }
      const gx = m.match(/^43(\d+)([\s\S]*)/); if (!gx) return;
      const aNum = parseInt(gx[1], 10); let res = null; try { res = JSON.parse(gx[2]); } catch (e) {}
      if (res && res[0] && res[0].token) tok = res[0].token;
      if (aNum === initAck && playAck < 0) { playAck = send('lobbyPlay', { token: tok, clientType: 'web', code }); return; }
      if (aNum === playAck && res && res[0] && res[0].redirectUrl) { done = true; clearTimeout(to); try { ws.close(); } catch (e) {} L('WS 拿到直連網址'); resolve(res[0].redirectUrl); }
    };
    ws.onerror = (e) => { clearTimeout(to); L('WS error(可能被 origin 擋)'); reject(new Error('WS錯誤')); };
  });
}

(function () { try { const s = JSON.parse(localStorage.getItem('seth_creds') || 'null'); if (s) { $('base').value = s.base || $('base').value; $('u').value = s.u || ''; $('p').value = ''; $('r').checked = true; } } catch (e) {} })();

// ★登入頁公告：獨立載入、逐欄位判空、圖片載入失敗自動隱藏。整段 try/catch 包死——
//   公告有任何狀況（抓不到/欄位缺/圖裂）都只是「不顯示那部分」，登入功能永遠不受影響。
async function loadAnnouncement() {
  try {
    if (!window.SethEyeAPI || !SethEyeAPI.announcement) return;
    const a = await SethEyeAPI.announcement();   // API client 已保證抓失敗回 {enabled:false}
    if (!a || !a.enabled) return;                // 沒公告 → 公告區維持隱藏（登入頁原樣）
    const box = $('announce'); if (!box) return;
    const setText = (id, val) => { const el = $(id); if (!el) return; const s = (val == null ? '' : String(val)).trim(); if (s) { el.textContent = s; el.classList.remove('hide'); } else { el.classList.add('hide'); } };
    // 標題 / 內文（textContent 自動跳脫、不怕 HTML 注入破版）
    setText('announceTitle', a.title);
    setText('announceText', a.text);
    // 按鈕（要有文字 + https 連結才顯示）
    const btn = $('announceBtn');
    if (btn) {
      const bt = (a.buttonText || '').trim(), bu = (a.buttonUrl || '').trim();
      if (bt && /^https:\/\//i.test(bu)) { btn.textContent = bt; btn.href = bu; btn.classList.remove('hide'); }
      else btn.classList.add('hide');
    }
    // 圖片（載入成功才顯示；裂圖 onerror 自動隱藏，不留破圖）
    const img = $('announceImg');
    if (img) {
      const url = (a.imageUrl || '').trim();
      if (url && /^https:\/\//i.test(url)) {
        // ★圖片 onload 是非同步的：純圖片公告(title/text 空)時，下面 hasContent 檢查會在圖載完前就跑→
        //   公告區 box 被判 false 藏起來→圖明明載好卻看不到(2026-08-04 修)。onload 時一併顯示 box。
        img.onload = function () { img.classList.remove('hide'); if (box) box.classList.remove('hide'); };
        img.onerror = function () { img.classList.add('hide'); L('公告圖載入失敗、已隱藏'); };
        img.src = url;
        // ★imageLink 有值 → 整張圖可點、開該連結（圖本身當 CTA）；無值則純圖片不可點
        const link = (a.imageLink || '').trim();
        if (link && /^https:\/\//i.test(link)) {
          img.style.cursor = 'pointer';
          img.onclick = function () { try { window.open(link, '_system'); } catch (e) { try { window.open(link, '_blank'); } catch (_) {} } };
        } else { img.style.cursor = ''; img.onclick = null; }
      } else img.classList.add('hide');
    }
    // 至少有一個內容才顯示整個公告區（全空就不出現空框）
    const hasContent = ['announceTitle', 'announceText', 'announceBtn', 'announceImg'].some(id => { const el = $(id); return el && !el.classList.contains('hide'); });
    if (hasContent) box.classList.remove('hide');
  } catch (e) { try { L('公告載入例外(不影響登入)', e && e.message); } catch (_) {} }
}
try { loadAnnouncement(); } catch (e) {}

const SETH_LINE = 'https://lin.ee/2d6eepFU';   // 聖甲之心客服 LINE（API 失敗也會回 lineUrl，優先用回的）
window.SETH_LINE = SETH_LINE;   // 給錯誤記錄卡「聯繫客服」用
// 錯誤顯示：白話訊息 + 可點診斷碼(開錯誤記錄卡)；ctx 帶帳號/娛樂城/遊戲
function errCtx() { return { account: (session && session.account) || ($('u') && $('u').value.trim()) || '', base: ($('base') && $('base').value) || '', game: ($('game') && $('game').value) || '' }; }
function showErrInto(elId, info) { const el = $(elId); if (!el || !info) return; el.innerHTML = '<span style="color:#ff8c8c">' + info.human + '</span> <a href="#" onclick="SethErr.showLog();return false;" style="color:#9c8a66;text-decoration:underline;font-size:12px;white-space:nowrap">診斷碼 ' + info.code + '</a>'; }

// ★ 使用資格兩關（按「進房」時打）：①聖甲之心助手會員登入 — 用娛樂城同一組帳密自動登入(前端已保證兩邊密碼一致、不另跳窗)
//   ②eligibility 即時檢查。任一關失敗 → 跳 LINE 彈窗連客服。
async function memberGate() {
  if (!SethEyeAPI.token) {
    let j; try { j = await SethEyeAPI.login(session.account, session.password); } catch (e) { j = null; }
    if (!j || !j.token) { showLineDialog((j && j.message) || '無法驗證聖甲之心資格，請聯繫客服', (j && j.lineUrl) || SETH_LINE); return false; }
  }
  let el; try { el = await SethEyeAPI.eligibility(); } catch (e) { el = null; }
  if (!el || !el.eligible) { showLineDialog('請聯繫聖甲之心客服開通功能', (el && el.lineUrl) || SETH_LINE); return false; }
  refreshCoins();   // 順便更新選房頁金幣/銀幣餘額
  return true;
}

// 訊息彈窗 + 一顆「聯繫客服 LINE」按鈕（資格不符 / 密碼錯誤共用）
function showLineDialog(message, lineUrl) {
  const old = document.getElementById('cpModal'); if (old) old.remove();
  const mask = document.createElement('div'); mask.id = 'cpModal';
  mask.style.cssText = 'position:fixed;inset:0;background:rgba(0,0,0,.62);display:flex;align-items:center;justify-content:center;z-index:9999;padding:26px';
  const box = document.createElement('div'); box.style.cssText = 'background:#1a140d;border:1px solid #6b5630;border-radius:16px;padding:24px 20px 18px;max-width:330px;width:100%;text-align:center;box-shadow:0 14px 44px rgba(0,0,0,.55)';
  box.innerHTML = '<div style="font-size:15px;color:#f5e6c8;line-height:1.85;margin-bottom:18px;word-break:keep-all">' + message + '</div>';
  const row = document.createElement('div'); row.style.cssText = 'display:flex;gap:10px';
  const close = document.createElement('button'); close.textContent = '關閉'; close.style.cssText = 'flex:1;min-height:46px;border:1px solid #5a4a2a;border-radius:11px;background:#2a2018;color:#c9b890;font-size:15px;font-weight:700';
  close.onclick = () => mask.remove();
  const line = document.createElement('button'); line.textContent = '聯繫客服 LINE'; line.style.cssText = 'flex:1.3;min-height:46px;border:0;border-radius:11px;background:linear-gradient(180deg,#06c755,#04a548);color:#fff;font-size:15px;font-weight:800';
  line.onclick = () => { try { (window.cordova && window.cordova.InAppBrowser ? window.cordova.InAppBrowser : window).open(lineUrl, '_system'); } catch (e) { try { window.open(lineUrl, '_blank'); } catch (_) {} } mask.remove(); };
  row.appendChild(close); row.appendChild(line); box.appendChild(row); mask.appendChild(box); document.body.appendChild(mask);
}

// 更新選房頁金幣/銀幣餘額（會員登入後 / 買通行證後）
function coinHtml(g, s) {
  const one = (src, n, color) => '<span style="display:inline-flex;align-items:center;gap:3px"><img src="' + src + '" style="width:17px;height:17px"><b style="color:' + color + '">' + (n != null ? n : '—') + '</b></span>';
  return one('coin_gold.png', g, '#ffe9a0') + '　' + one('coin_silver.png', s, '#dfe6f0');
}
// 確保聖甲之心助手已登入(token)；沒有就用 session 帳密補登一次。修「順便登入靜默失敗→金幣不顯示」
async function ensureSethLogin() {
  if (SethEyeAPI.token) return true;
  if (!session || !session.account) return false;
  try { const j = await SethEyeAPI.login(session.account, session.password); return !!(j && j.token); } catch (e) { return false; }
}
async function refreshCoins(coins) {
  const el = $('coinBal'); if (!el) return;
  const warn = () => { el.innerHTML = '<span style="color:#ffb86b;font-size:13px;font-weight:700;cursor:pointer">⚠ 點我重新整理金幣</span>'; el.style.cursor = 'pointer'; el.onclick = () => refreshCoins(); };
  const set = (g, s) => { el.innerHTML = coinHtml(g, s); el.style.cursor = ''; el.onclick = null; };
  if (coins) { set(coins.gold, coins.silver); return; }              // buy-pass 直接帶餘額回來
  if (!session || !session.account) { set(null, null); return; }      // 還沒登入→「—」
  if (!SethEyeAPI.token) { const ok = await ensureSethLogin(); if (!ok) { warn(); return; } }   // token 沒設→補登一次
  try { const m = await SethEyeAPI.member(); if (m && m.isMember) set(m.gold, m.silver); else warn(); }
  catch (e) { warn(); }
}

async function login() {
  $('err').textContent = ''; $('loginBtn').disabled = true; $('loginBtn').textContent = '登入中…';
  try {
    const base = $('base').value, u = $('u').value.trim(), p = $('p').value;
    L('登入', base, u);
    const j = await postJson(base + '/api/v1/login', { username: u, password: p, device_id: deviceId() });
    const token = j && j.data && j.data.token;
    if (!token) {
      // ②-b 娛樂城登入失敗（金盈匯密碼錯）→ 外掛自己跳「金盈匯密碼錯誤」+ LINE（OFA 測試入口走一般錯誤）
      if (/gw1688/.test(base)) { $('loginBtn').disabled = false; $('loginBtn').textContent = '登入'; showLineDialog('金盈匯密碼錯誤，請聯繫聖甲之心客服', SETH_LINE); return; }
      throw new Error((j && j.message) || '帳號或密碼錯誤');
    }
    session = { base, token, account: u, password: p, game: $('game').value };   // account/password=金盈匯帳密(聖甲之心助手會員登入同帳密)
    if ($('r').checked) localStorage.setItem('seth_creds', JSON.stringify({ base, u })); else localStorage.removeItem('seth_creds');
    $('who').textContent = '已登入：' + u;
    try { await SethEyeAPI.bindLogin(u); } catch (e) {}   // ★金盈匯驗過→只傳帳號、後端自動建帳本(無感綁定、預設密碼)+補幣+發token；不再要求聖甲之心助手密碼==金盈匯密碼
    // ── 遊戲商別分流(雷神整合 Phase 1) ──────────────────────────────
    // RSG(雷神)：沒有選房/榜單機制 → 不顯示 roomView、不 loadRecommended、直接進遊戲(enterGameRSG，Phase 2 接引擎)。
    // ATG(賽特三款)：維持原流程——顯示選房頁 + 拉四榜。
    if (isRSG(session.game)) {
      L('RSG 分流：game=' + session.game + ' gameId=' + rsgGameId(session.game) + ' → 資格閘→直接進遊戲');
      // ★雷神資格閘(Phase 3)：雷神引擎沒有引擎內資格檢查(賽特是引擎內做)→進場前在 app.js 擋。
      //   ①聖甲之心助手會員登入(同帳密) ②eligibility 帶 game=thor 讓後端分辨。任一關失敗→跳 LINE 客服、不進遊戲。
      const gateOk = await rsgGate();
      if (gateOk) { try { await enterGameRSG(); } catch (e) { L('RSG 進場失敗', e && e.message); showErrInto('err', window.SethErr ? SethErr.handle('ENTER', e, errCtx()) : { human: (e.message || '進入失敗'), code: '-' }); } }
    } else {
      $('loginView').classList.add('hide'); $('roomView').classList.remove('hide');
      loadRecommended();
    }
    refreshCoins();
    L('登入成功');
  } catch (e) { L('登入失敗', e && e.message); showErrInto('err', window.SethErr ? SethErr.handle('LGN', e, errCtx()) : { human: (e.message || '登入失敗，請稍後再試'), code: '-' }); }
  finally { $('loginBtn').disabled = false; $('loginBtn').textContent = '登入'; }
}

// mode: undefined=用輸入的房號 / 'manual'=略過自己選房 / 'auto'=自動選房(挑得分率最高空台)
// ===== 聖甲之心 custom in-game UI =====
const SCARAB_OVERLAY_SRC = `(function(){
if(window.__scarabHeartUI)return;window.__scarabHeartUI=true;
var host=document.createElement('div');host.id='scarab-heart-ui';
host.innerHTML='\
<div id="scPanel" class="shMini">\
  <div class="shHead"><img src="data:image/png;base64," class="shBrand"><div class="shPnl"><small>PNL</small><strong id="scPnl">+0.00</strong></div><span id="scStatus" class="shDot"></span></div>\
  <div class="scNav">\
    <button id="scStart" class="shCore" aria-label="auto"><span class="shIcon"><svg viewBox="0 0 32 32" aria-hidden="true"><path d="M7 11a10 10 0 0 1 16-3l2 2"/><path d="M25 5v5h-5"/><path d="M25 21a10 10 0 0 1-16 3l-2-2"/><path d="M7 27v-5h5"/><path class="fill" d="M13 11.5 21 16l-8 4.5z"/></svg></span></button>\
    <button data-tab="speed" aria-label="speed"><span class="shIcon"><svg viewBox="0 0 32 32" aria-hidden="true"><path d="M5 9l7 7-7 7"/><path d="M12 9l7 7-7 7"/><path d="M19 9l7 7-7 7"/></svg></span></button>\
    <button data-tab="guard" aria-label="guard"><span class="shIcon"><svg viewBox="0 0 32 32" aria-hidden="true"><path d="M16 4 25 8v7c0 6-3.8 10.4-9 13-5.2-2.6-9-7-9-13V8z"/><path d="m11 16 3 3 7-7"/></svg></span></button>\
    <button data-tab="signal" aria-label="signal"><span class="shIcon"><svg viewBox="0 0 32 32" aria-hidden="true"><circle cx="16" cy="17" r="2.5"/><path d="M10.5 17a5.5 5.5 0 0 1 11 0"/><path d="M6.5 17a9.5 9.5 0 0 1 19 0"/><path d="M16 4v5"/><path d="m8 7 3 4"/><path d="m24 7-3 4"/></svg></span></button>\
    <button data-tab="free" aria-label="free"><span class="shIcon"><svg viewBox="0 0 32 32" aria-hidden="true"><path d="m16 4 10 9-10 15L6 13z"/><path d="M6 13h20"/><path d="m11 13 5-9 5 9"/><path d="m11 13 5 15 5-15"/></svg></span></button>\
    <button data-tab="room" aria-label="room"><span class="shIcon"><svg viewBox="0 0 32 32" aria-hidden="true"><path d="M5 13 16 5l11 8"/><path d="M8 12v14h16V12"/><path d="M13 26v-8h6v8"/><path d="M3.5 20h5"/><path d="m6 17-3 3 3 3"/></svg></span></button>\
  </div>\
  <div class="scPane scSpeedPane" data-pane="speed"><div class="scTitle">速度控制</div><div class="scGrid" id="scSpeedGrid"><button data-sp="1" class="on">1X</button><button data-sp="2">2X</button><button data-sp="4">4X</button><button data-sp="8">8X</button><button data-sp="16">16X</button><button data-sp="max">MAX</button></div></div>\
  <div class="scPane" data-pane="guard">\
    <div class="scPaneHead"><div><b>停利停損</b><small>達到條件自動停止</small></div><button id="scGuard" class="scToggle">OFF</button></div>\
    <div class="scInfo"><span>本場輸贏</span><b id="scGuardPnl">+0.00</b></div>\
    <label class="scField"><span>止盈</span><input id="scTp" type="number" inputmode="decimal" value="0"></label>\
    <label class="scField"><span>止損</span><input id="scSl" type="number" inputmode="decimal" value="0"></label>\
