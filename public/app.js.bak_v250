function fmtGood(n){n=Number(n);if(!isFinite(n))return '—';var a=Math.abs(n);if(a>=10000)return (n/10000).toFixed(a>=100000?1:2).replace(/\.0+$/,'')+'萬';return Math.round(n).toLocaleString();}
function buildGoodRooms(){var box=document.getElementById('scGoodRooms');if(!box)return;var e=eng(),rooms=(e&&e.__goodRooms)||window.__SC_GOOD_ROOMS||[];box.innerHTML='';if(!rooms.length){box.innerHTML='<div class="scGoodEmpty">目前沒有可用推薦資料</div>';return;}rooms.slice(0,3).forEach(function(c,i){var rtp=c.rtp!=null?c.rtp:(c.todayRtp!=null?c.todayRtp:'—'),bet=c.bet!=null?c.bet:c.todayBet,raw=c.profit!=null?c.profit:c.todayPnl,pnl=raw==null?null:-(Number(raw)||0),row=document.createElement('div');row.className='scGoodRow';row.innerHTML='<div class="scGoodTop"><span>'+(i===0?'🥇':i===1?'🥈':'🥉')+'</span><b>'+String(c.machineNum||'—').padStart(3,'0')+'房</b><span class="rtp">RTP '+rtp+(rtp==='—'?'':'%')+'</span></div><div class="scGoodSub"><span>下注量 '+fmtGood(bet)+'</span><span>｜前手 '+(pnl==null?'—':((pnl>=0?'+':'')+Math.round(pnl).toLocaleString()))+'</span><button>前往</button></div>';row.querySelector('button').onclick=function(ev){ev.stopPropagation();location.href='https://__sethcmd__/pick?ri='+encodeURIComponent(c.roomId||'')+'&mn='+encodeURIComponent(c.machineNum||'')};box.appendChild(row)});}
document.getElementById('scRefreshGood').onclick=function(ev){if(ev)ev.stopPropagation();buildGoodRooms();this.textContent='已更新';var b=this;setTimeout(function(){b.textContent='🔍 重新尋找'},700)};
document.getElementById('scFree').onclick=function(){free=!free;var e=eng(),p=pan();try{if(e&&e.setFreeAuto)e.setFreeAuto(free);if(e&&e.setFreeAutoSkip)e.setFreeAutoSkip(free)}catch(x){}if(p)p.freeAuto=free;setToggle(this,free)};
document.getElementById('scSpoil').onclick=function(){spoil=!spoil;var e=eng(),p=pan();try{if(e&&e.setFreeSpoiler)e.setFreeSpoiler(spoil)}catch(x){}if(p)p.spoilerOn=spoil;setToggle(this,spoil)};
document.getElementById('scRoom').onclick=function(){location.href=window.__thorEngine?'https://__thorcmd__/home':'https://__sethcmd__/rooms'};document.getElementById('scHome').onclick=function(){location.href=window.__thorEngine?'https://__thorcmd__/home':'https://__sethcmd__/home'};
buildGoodRooms();
function __fitNum(el,text,base){if(!el)return;el.textContent=text;el.style.whiteSpace='nowrap';el.style.overflow='visible';el.style.textOverflow='clip';el.style.maxWidth='100%';el.style.minWidth='0';el.style.fontSize=base+'px';el.style.lineHeight='1.05';var parent=el.parentElement,avail=parent?Math.max(36,parent.clientWidth-(el.offsetLeft||0)-4):0,px=base;while(avail>0&&el.scrollWidth>avail&&px>7){px--;el.style.fontSize=px+'px';}}
setInterval(function(){var e=eng(),p=pan(),r=null,fg=0,pnl=0;try{if(p&&p.spoilerWin){var q=p.spoilerWin;r=q.totalWin!=null?q.totalWin:(q.totalWinnings!=null?q.totalWinnings:null);fg=q.fg||q.freeGameCount||0}else if(e&&e.spoiler){r=e.spoiler.totalWin||e.spoiler.win||null;fg=e.spoiler.fg||e.spoiler.freeGameCount||0}pnl=(e&&e.pnl!=null)?e.pnl:((p&&p.pnl!=null)?p.pnl:0)}catch(x){}var ps=(+pnl||0),txt=(ps>=0?'+':'')+ps.toFixed(2);__fitNum(document.getElementById('scPnl'),txt,11);__fitNum(document.getElementById('scGuardPnl'),txt,17);var old=legacyRoot();if(old){old.style.removeProperty('left');old.style.removeProperty('top');old.style.removeProperty('opacity');old.style.removeProperty('pointer-events')}} ,500);
})();`;


async function enterGame(mode) {
  const btns = ['enterBtn', 'skipBtn', 'autoBtn'].map($).filter(Boolean);
  $('err2').textContent = ''; btns.forEach(b => b.disabled = true);
  const active = mode === 'manual' ? $('skipBtn') : mode === 'auto' ? $('autoBtn') : $('enterBtn');
  const activeOrig = active && active.textContent; if (active) active.textContent = '進入中…';
  try {
    // 進房全放行（能進房/看榜/開面板）；資格攔截改到引擎端「按開始/開轉/買免遊」那一刻
    let room, machineNumHint = '', boardName = '', boardList = null;
    // targetKind='roomId'：明確告訴引擎「room 是 roomId、照 roomId 定位」，不讓引擎靠格式猜。
    //   根因：賽一 roomId 是純數字(305497)、賽二含底線(seth2_306439)，引擎舊版靠「含非數字」判 roomId→賽一被漏→卡選房。
    let targetKind = null;
    if (mode === 'manual') room = '';             // 空房號 → 引擎手動模式：玩家自己在大廳點機台
    else if (mode === 'auto') room = 'AUTO';       // AUTO → 引擎自動挑空台得分率最高者
    else if (mode === 'pick' && pendingPick) {     // 點推薦卡：roomId 當 TARGET(穩定)、machineNum 當提示(fallback)
      room = pendingPick.roomId || String(pendingPick.machineNum);
      if (pendingPick.roomId) targetKind = 'roomId';   // 有 roomId → 明確標記走 roomId 定位(不管純數字或含底線)
      machineNumHint = String(pendingPick.machineNum || '');
      boardName = pendingPick.boardName || '';
      // 該分類榜單(由高到低)→引擎在「指定房有人」時可自動換同分類次高空台
      const bl = (_boards && _boards[pendingPick.board]) || [];
      boardList = bl.filter(c => c && c.roomId != null && c.machineNum != null).map(c => ({ roomId: String(c.roomId), machineNum: String(c.machineNum), score: c.score }));
    }
    else { room = ($('room').value || '').trim(); if (!room) throw new Error('請輸入房號，或按「略過」自己選房'); }
    L('取得 game_url …', 'mode=' + (mode || 'manual-num'), 'room=' + room, 'mnHint=' + machineNumHint, 'kind=' + (targetKind || '-'));
    // ★token 過期自動重登(2026-08-02)：session.token 是登入時拿的、放久(實測 8hr)會過期→gw1688 回 401→game_url 空→
    //   舊版直接報「拿不到遊戲網址」讓用戶狂試(w123aaaa 06:49登入、14:49進房隔8hr、連試14次全失敗)。
    //   改：第一次拿不到 game_url 就用 session 帳密重登拿新 token、再試一次。session 有存 account/password。
    const fetchGameUrl = async (tok) => {
      const atgBody=(session.platform==='OFA')?{game_return_url:'https://www.ofa1188.net',game_kind:'SLOT',game_device:'Desktop',game_money:''}:{game_return_url:session.base,game_kind:'',game_type:'',game_device:'Mobile'}; const j = await postJson(session.base + '/api/v2/game/ATG/login', atgBody, tok);
      return j && j.data && j.data.game_url;
    };
    let gameUrl = await fetchGameUrl(session.token);
    if (!gameUrl && session.account && session.password) {
      L('拿不到 game_url→token 可能過期、用帳密重登再試');
      try {
        const rj = await postJson(session.base + '/api/v1/login', { username: session.account, password: session.password, device_id: deviceId() });
        const newTok = rj && rj.data && rj.data.token;
        if (newTok) { session.token = newTok; gameUrl = await fetchGameUrl(newTok); L('重登後 game_url=' + (gameUrl ? 'OK' : '仍無')); }
      } catch (e) { L('重登失敗', e && e.message); }
    }
    if (!gameUrl) throw new Error('拿不到遊戲網址');
    const m = gameUrl.match(/[?&]t=([^&]+)/);
    let target = gameUrl;
    if (m) {
      try { L('WS 換直連…'); target = await directGameUrl(m[1], session.game); L('直連網址 OK'); }
      catch (e) { L('WS 失敗 → 退回大廳網址', e && e.message); target = gameUrl; }
    }
    let scoreMap = null;
    if (mode === 'auto') scoreMap = await fetchRoomScores(session.game, session.base);   // 自動選房：先拉聖甲之心助手綜合分數（未接到→null→引擎退回遊戲內得分率）
    openGame(target, room, scoreMap, machineNumHint, boardName, boardList, targetKind);
  } catch (e) { L('進入失敗', e && e.message); showErrInto('err2', window.SethErr ? SethErr.handle('ENTER', e, errCtx()) : { human: (e.message || '進入失敗'), code: '-' }); }
  finally { btns.forEach(b => b.disabled = false); if (active) active.textContent = activeOrig; }
}

// ══ 雷神二代（RSG）資格閘 ══════════════════════════════════════════════
// 雷神引擎無引擎內資格檢查(賽特是引擎內做)→進場前在 app.js 擋。過→true 進遊戲、不過→跳 LINE 客服回 false。
async function rsgGate() {
  try {
    // ①聖甲之心助手會員登入(同金盈匯帳密、bindLogin 已在 login() 建帳本)
    if (!SethEyeAPI.token) {
      let j; try { j = await SethEyeAPI.login(session.account, session.password); } catch (e) { j = null; }
      if (!j || !j.token) { showLineDialog((j && j.message) || '無法驗證聖甲之心資格，請聯繫客服', (j && j.lineUrl) || SETH_LINE); return false; }
    }
    // ②eligibility 帶 game=thor(後端分辨雷神、查白名單代理線)
    let el; try { el = await SethEyeAPI.eligibility('thor'); } catch (e) { el = null; }
    L('RSG eligibility', JSON.stringify(el));
    if (!el || !el.eligible) { showLineDialog((el && el.reason) || '請聯繫聖甲之心客服開通功能', (el && el.lineUrl) || SETH_LINE); return false; }
    return true;
  } catch (e) { L('rsgGate err', e && e.message); showLineDialog('資格驗證失敗，請聯繫客服', SETH_LINE); return false; }
}

// ══ 雷神二代（RSG）進場鏈 ══════════════════════════════════════════════
// 跟 ATG 完全不同：打 /api/v2/game/RSG/login 拿大廳URL → 大廳頁 executeScript 跑 GetGameURL 導頁
// → 遊戲頁(/Web/SlotGame\d) 注入雷神引擎 THOR_ENGINE_SRC。全程不碰選房/榜單/roomId。
async function enterGameRSG() {
  const gameId = rsgGameId(session.game) || '129';   // 129=二代(先只上二代)
  L('RSG 進場：打 /api/v2/game/RSG/login gameId=' + gameId);
  // 打 RSG login 拿大廳URL(token 過期自動重登再試，同 ATG 進房的保護)
  const fetchLobby = async (tok) => {
    const j = await postJson(session.base + '/api/v2/game/RSG/login', { game_return_url: session.base, game_kind: '', game_type: '', game_device: 'Mobile' }, tok);
    return j && j.data && j.data.game_url;
  };
  let lobbyUrl = await fetchLobby(session.token);
  if (!lobbyUrl && session.account && session.password) {
    L('拿不到 RSG 大廳URL→token 可能過期、重登再試');
    try { const rj = await postJson(session.base + '/api/v1/login', { username: session.account, password: session.password, device_id: deviceId() }); const nt = rj && rj.data && rj.data.token; if (nt) { session.token = nt; lobbyUrl = await fetchLobby(nt); } } catch (e) { L('RSG 重登失敗', e && e.message); }
  }
  if (!lobbyUrl) throw new Error('拿不到 RSG 大廳網址');
  openGameRSG(lobbyUrl, gameId);
}

function openGameRSG(lobbyUrl, gameId) {
  const hasIAB = !!(window.cordova && window.cordova.InAppBrowser);
  const opener = hasIAB ? window.cordova.InAppBrowser : window;
  const isIOS = !!(window.Capacitor && window.Capacitor.getPlatform && window.Capacitor.getPlatform() === 'ios');
  const iabOpts = isIOS ? 'location=no,zoom=no,hidden=no,toolbar=no'
                        : 'location=no,zoom=no,hidden=no,toolbar=yes,hardwareback=yes';
  const ref = opener.open(lobbyUrl, '_blank', iabOpts);
  if (!ref || !ref.addEventListener) { L('RSG IAB ref 無 addEventListener'); $('err').textContent = '無法開遊戲視窗'; return; }
  $('loginView').classList.add('hide');
  unlockOri();   // RSG 不固定方向，依實際遊戲版型自動切換

  let navigated = false;
  // 大廳頁：等 LobbySession → 跑 GetGameURL 拿真錢遊戲頁 → 導頁
  const lobbyNavCode = "(function(){try{if(window.__thorNav)return;window.__thorNav=true;" +
    "var tries=0;var iv=setInterval(function(){tries++;var sk=sessionStorage.getItem('LobbySession');" +
    "if(!sk){if(tries>30)clearInterval(iv);return;}clearInterval(iv);" +
    "fetch('../Lobby/GetGameURL?k='+sk+'&id=" + gameId + "&lobby=2',{cache:'no-cache'})" +
    ".then(function(r){return r.json();}).then(function(d){" +
    "sessionStorage.setItem('GameWebSession2',d.newsession);localStorage.setItem('backupSession',d.newsession);" +
    "location.href=location.origin+d.nextpage;}).catch(function(e){});},500);}catch(e){}})();";

  // 遊戲頁：注入雷神引擎(overlay UI)
  // 帶 SETH_API/KEY/ACCOUNT → 雷神引擎「餘額不足跳存款彈窗」用(同賽特)。
  const cfg = { MUTE: true, DEBUG: true, SPEED: 1, UI: 'none', GAME_ID: String(gameId),
    SETH_API: SethEyeAPI.CFG.API_BASE, SETH_KEY: SethEyeAPI.CFG.COPILOT_KEY, SETH_ACCOUNT: (session && session.account) || '',
    AGENT_MODE: true };   // ★代理版旗標傳給雷神引擎(不跳儲值彈窗)
  const RSG_STABILITY_SRC = `;(function(){if(window.__scarabRsgStable)return;window.__scarabRsgStable=1;function wake(){try{window.focus();document.documentElement.style.minHeight='100%';document.body.style.minHeight='100%';window.dispatchEvent(new Event('resize'));}catch(e){}}document.addEventListener('visibilitychange',function(){if(!document.hidden)setTimeout(wake,60)});window.addEventListener('focus',wake);window.addEventListener('pageshow',wake);window.addEventListener('orientationchange',function(){setTimeout(wake,120);setTimeout(wake,420)});setInterval(function(){if(!document.hidden)wake()},4000);})();`;
  const engineCode = window.THOR_ENGINE_SRC + "\n;if(!window.__thorBooted){window.__thorBooted=true;try{thorEngine(" + JSON.stringify(cfg) + ");console.log('[THOR] engine() called');}catch(_e){console.log('[THOR] engine err '+(_e&&_e.message));}}" + SCARAB_OVERLAY_SRC + RSG_STABILITY_SRC;

  // ★網域不寫死(2026-08-03 真機實證)：實際遊戲網域是 gameweb2.rsgaming955.com(不是交接文件的 royalgaming777.com、RSG 會換網域)。
  //   改認路徑 /Web/SlotGame\d + /Lobby，不綁特定網域→換網域也不會漏注入。
  const isRSGLobby = (u) => /\/Lobby2?\//i.test(u || '');
  const isRSGGame = (u) => /\/Web\/SlotGame\d/i.test(u || '');

  ref.addEventListener('loadstop', (e) => {
    const u = (e && e.url) || '';
    L('RSG loadstop ' + u.slice(0, 60));
    if (isRSGGame(u)) { L('RSG 遊戲頁→注入雷神引擎＋自動方向'); try { ref.executeScript({ code: engineCode }); ref.executeScript({code:'[window.innerWidth,window.innerHeight]'},function(v){try{var d=v&&v[0];if(d&&d[0]>d[1]){lockLandscape();}else{lockPortrait();}}catch(_){}}); } catch (x) { L('RSG 注入例外', x && x.message); } }
    else if (isRSGLobby(u) && !navigated) { navigated = true; L('RSG 大廳頁→跑 GetGameURL 導頁'); try { ref.executeScript({ code: lobbyNavCode }); } catch (x) {} }
  });
  // 回登入 sentinel(雷神用 __thorcmd__/home)+ exit 兜底
  const backToLogin = () => { lockPortrait(); $('loginView').classList.add('hide'); $('roomView').classList.add('hide'); $('gameCenterView').classList.remove('hide'); scarabProvider='RSG'; renderScarabGames(); try { ref.close(); } catch (_) {} setTimeout(()=>window.scrollTo(0,scarabGameCenterScrollY),0); };
  const rsgCmd = (u) => {
    if (/__thorcmd__\/home/.test(u || '')) { L('RSG 回遊戲中心'); backToLogin(); return true; }
    if (/__thorcmd__\/deposit/.test(u || '')) { L('RSG 餘額不足→關遊戲、開存款頁自動登入'); lockPortrait(); $('loginView').classList.remove('hide'); try { ref.close(); } catch (_) {} openDepositWithLogin(); return true; }   // 雷神餘額不足彈窗「前往儲值」→自動登入存款頁(同賽特)
    return false;
  };
  ref.addEventListener('loadstart', (e) => { rsgCmd((e && e.url) || ''); });
  ref.addEventListener('loaderror', (e) => { rsgCmd((e && e.url) || ''); });
  ref.addEventListener('exit', () => { if ($('gameCenterView').classList.contains('hide')) { L('RSG IAB exit 兜底→回遊戲中心'); lockPortrait(); $('loginView').classList.add('hide'); $('roomView').classList.add('hide'); $('gameCenterView').classList.remove('hide'); scarabProvider='RSG'; renderScarabGames(); setTimeout(()=>window.scrollTo(0,scarabGameCenterScrollY),0); } });
}

// ★開存款頁並自動登入(2026-07-19)：餘額不足彈窗「前往儲值」用。
//   金盈匯存款頁 SPA 認 localStorage.token=已登入(逆向確認、只需 token)。外掛有 gw 帳密→重登拿新 token
//   →InAppBrowser 開存款頁→loadstop 注入 token+reload→SPA 直接登入顯示存款頁。iOS/安卓同套。
//   ★鐵律：自動登入任何一步失敗都 fallback 直接開存款頁(用戶自己登入)、絕不卡死。
const DEPOSIT_URL = 'https://setheye.gw1688.net/service/deposit';
async function openDepositWithLogin() {
  const opener = (window.cordova && window.cordova.InAppBrowser) ? window.cordova.InAppBrowser : window;
  // 沒 session(理論上餘額不足=已登入遊戲、一定有) → 直接開頁讓用戶自己登入
  if (!session || !session.account || !session.password || !session.base) { try { opener.open(DEPOSIT_URL, '_system'); } catch (e) {} return; }
  let token = null;
  try {
    // 重登拿新 token(遊戲玩久 session.token 可能過期、存款頁要有效 token)
    const j = await postJson(session.base + '/api/v1/login', { username: session.account, password: session.password, device_id: deviceId() });
    token = j && j.data && j.data.token;
  } catch (e) { L('存款頁重登失敗', e && e.message); }
  if (!token) { L('拿不到 token → fallback 直接開存款頁'); try { opener.open(DEPOSIT_URL, '_system'); } catch (e) {} return; }
  try {
    const isIOS = !!(window.Capacitor && window.Capacitor.getPlatform && window.Capacitor.getPlatform() === 'ios');
    const opts = isIOS ? 'location=no,zoom=no,hidden=no,toolbar=yes' : 'location=no,zoom=no,hidden=no,toolbar=yes,hardwareback=yes';
    const ref = opener.open(DEPOSIT_URL, '_blank', opts);
    if (!ref || !ref.addEventListener) { try { opener.open(DEPOSIT_URL, '_system'); } catch (e) {} return; }
    let injected = false;
    // 注入 token → 導到存款頁(SPA 認 localStorage.token=已登入)。
    //   實測(2026-07-19)：塞 token 後 SPA 不再踢登入頁、直達會員後台。導 /service/deposit 停在存款頁。
    //   ★覆蓋殘留舊 token(2026-07-24)：IAB localStorage 持久，上次的舊 token 會殘留。舊版「沒 token 才塞」→
    //     殘留的過期 token 不被覆蓋 → SPA 驗過期 → 踢登入頁 = 「有時自動帶入、有時要重登」的真兇(舊 token 沒過期才僥倖成功)。
    //     改「跟新 token 不同就覆蓋」：每次都塞剛重登的新鮮 token；reload 後兩者相同→不重塞、無限迴圈免疫。
    const inject = () => {
      if (injected) return; injected = true;
      const code = 'try{if(localStorage.getItem("token")!==' + JSON.stringify(token) + '){localStorage.setItem("token",' + JSON.stringify(token) + ');location.href="/service/deposit";}}catch(e){}';
      try { ref.executeScript({ code: code }, () => L('存款頁 token 注入(覆蓋舊)+導存款頁')); } catch (e) { L('存款頁注入例外', e && e.message); }
    };
    ref.addEventListener('loadstop', () => inject());
  } catch (e) { L('開存款頁例外 → fallback', e && e.message); try { opener.open(DEPOSIT_URL, '_system'); } catch (_) {} }
}

function openGame(url, room, scoreMap, machineNumHint, boardName, boardList, targetKind) {
  const hasIAB = !!(window.cordova && window.cordova.InAppBrowser);
  L('openGame hasIAB=' + hasIAB + ' url=' + url.slice(0, 60));
  const opener = hasIAB ? window.cordova.InAppBrowser : window;
  const isIOS = !!(window.Capacitor && window.Capacitor.getPlatform && window.Capacitor.getPlatform() === 'ios');
  const iabOpts = isIOS
    ? 'location=no,zoom=no,hidden=no,toolbar=no'                       // iOS:拿掉工具列(Done鈕在iOS浮成藍圓鈕殘存)→退出靠引擎HUD 🚪(Mac已實測可退/可重進)
    : 'location=no,zoom=no,hidden=no,toolbar=yes,hardwareback=yes';   // Android:維持頂部工具列+實體返回鍵
  const ref = opener.open(url, '_blank', iabOpts);
  if (!ref || !ref.addEventListener) { L('IAB ref 無 addEventListener！注入不可行'); $('err2').textContent = '無法開遊戲視窗（IAB 未就緒）'; return; }
  let recommendedAutoEnter = false;
  $('roomView').classList.add('hide');   // ★ iOS:IAB(toolbar) 沒蓋到底部安全區會露出選房頁殘存→開遊戲就主動藏；Android 一併乾淨。還原由 handleCmd 回選房/回主畫面 remove('hide')
  if(ATG_LANDSCAPE.has((session&&session.game)||'')){unlockOri();lockLandscape();}else{unlockOri();}   // 已確認橫式遊戲固定橫向，其餘跟隨遊戲→恢復跟隨感應器，玩家橫放即可轉橫（配合引擎內「請橫放」提示）；修「第二次進房卡直向」
  const cfg = { TARGET: String(room), TARGET_KIND: targetKind || null, MACHINENUM: String(machineNumHint || ''), MUTE: true, DEBUG: true, TAKE_PROFIT: 0, STOP_LOSS: 0, SPEED: 1, UI: 'none', NO_SHIFT: true, SCORE_MAP: scoreMap || null, BOARD_NAME: boardName || '', BOARD_LIST: boardList || null, GOOD_ROOMS: ((_boards&&_boards.composite)||[]).filter(c=>c&&c.machineNum!=null).slice(0,3).map(c=>({roomId:c.roomId,machineNum:c.machineNum,rtp:c.rtp!=null?c.rtp:c.todayRtp,bet:c.bet!=null?c.bet:c.todayBet,profit:c.profit!=null?c.profit:c.todayPnl})),
    // ★ 資格攔截：引擎在遊戲頁直接查 eligibility(CORS開)，傳 token/key/LINE + 攔截區(% 相對畫面)
    SETH_API: SethEyeAPI.CFG.API_BASE, SETH_KEY: SethEyeAPI.CFG.COPILOT_KEY, SETH_TOKEN: SethEyeAPI.token || '', SETH_LINE: SETH_LINE, AGENT_MODE: true,
    SETH_ACCOUNT: (session && session.account) || '', GAME_CODE: (session && session.game) || $('game').value || '', APP_VER: window.SETH_APP_VER || '',   // ★eligibility 被擋時記錄用(帳號/遊戲/版本)
    ELIG: { spin: { l: 47.1, t: 36.2, w: 52.9, h: 63.8 }, free: { l: 0.0, t: 59.6, w: 30.3, h: 40.4 } } };
  const code = "console.log('[SETH] inject start');" + window.SETH_ENGINE_SRC + "\n;if(!window.__sethBooted){window.__sethBooted=true;try{engine(" + JSON.stringify(cfg) + ");console.log('[SETH] engine() called');}catch(_e){console.log('[SETH] engine err '+(_e&&_e.message));}}" + "\n;window.__SC_GOOD_ROOMS=" + JSON.stringify(cfg.GOOD_ROOMS||[]) + ";window.__SC_GAME_CODE=" + JSON.stringify(cfg.GAME_CODE||'') + ";" + SCARAB_OVERLAY_SRC;
  const tryInject = (u) => {
    L('loadstop url=' + (u || '').slice(0, 70));
    if (/play\.godeebxp\.com\/egames/.test(u || '')) {   // 每次遊戲頁載入都注入(入座會重載→面板要重生)；__sethBooted 防同頁重複
      L('遊戲頁 → executeScript 注入');
      try { ref.executeScript({ code: code }, () => L('executeScript callback')); } catch (e) { L('executeScript 例外 ' + (e && e.message)); }
    }
  };
  ref.addEventListener('loadstop', (e) => tryInject(e && e.url));
  // 引擎面板「回選房／回主畫面」：引擎導向 sentinel URL → 這裡攔到 → 關遊戲視窗 + 顯示對應頁
  const handleCmd = (u) => {
    if (/__sethcmd__\/pick/.test(u)) { try { const q=new URL(u); const ri=q.searchParams.get('ri')||''; const mn=q.searchParams.get('mn')||''; const c=((_boards&&_boards.composite)||[]).find(x=>String(x.roomId||'')===String(ri)||String(x.machineNum||'')===String(mn)); if(c){ pendingPick={roomId:c.roomId,machineNum:c.machineNum,board:'composite',boardName:'綜合分數'}; $('room').value=String(c.machineNum||mn); recommendedAutoEnter=true; lockPortrait(); $('loginView').classList.add('hide'); $('roomView').classList.remove('hide'); try{ref.close();}catch(_){} return true; } }catch(_pickErr){} }
    // 先設好頁面可見性再 close，避免 close 同步觸發 exit 時 fallback 誤判（兩頁都藏）
    if (/__sethcmd__\/rooms/.test(u)) { L('回選房介面'); lockPortrait(); $('loginView').classList.add('hide'); $('roomView').classList.remove('hide'); try { ref.close(); } catch (_) {} loadRecommended(); return true; }
    if (/__sethcmd__\/home/.test(u)) { L('ATG 回遊戲中心'); lockPortrait(); $('loginView').classList.add('hide'); $('roomView').classList.add('hide'); $('gameCenterView').classList.remove('hide'); scarabProvider='ATG'; renderScarabGames(); try { ref.close(); } catch (_) {} setTimeout(()=>window.scrollTo(0,scarabGameCenterScrollY),0); return true; }
    if (/__sethcmd__\/deposit/.test(u)) { L('餘額不足→關遊戲、開存款頁自動登入'); lockPortrait(); $('loginView').classList.add('hide'); $('roomView').classList.remove('hide'); try { ref.close(); } catch (_) {} loadRecommended(); openDepositWithLogin(); return true; }   // 關遊戲回選房頁+開存款頁(自動登入)。用戶儲值完從選房頁重進遊戲
    return false;
  };
  ref.addEventListener('loadstart', (e) => { const u = (e && e.url) || ''; if (handleCmd(u)) return; L('loadstart url=' + u.slice(0, 70)); });
  ref.addEventListener('loaderror', (e) => { const u = (e && e.url) || ''; if (handleCmd(u)) return; L('loaderror ' + ((e && e.message) || '')); $('err2').textContent = '遊戲載入失敗'; });
  // 用戶用系統手勢 / IAB Done 鈕關閉遊戲視窗(非走回選房/回主畫面)：兩頁都還藏著→兜底回選房頁，避免卡空白(配合 openGame 開頭藏 roomView)
  ref.addEventListener('exit', () => { if(recommendedAutoEnter){ recommendedAutoEnter=false; L('好房推薦→IAB 已關閉，走原本推薦進房流程'); setTimeout(()=>enterGame('pick'),120); return; } if ($('roomView').classList.contains('hide') && $('loginView').classList.contains('hide')) { L('IAB exit 兜底→回選房'); lockPortrait(); $('roomView').classList.remove('hide'); loadRecommended(); } });
}

// 推薦空房：接聖甲之心助手 boards 綜合分榜(composite) → 顯示 machineNum + 分數（2026-06-27 wire 上）
async function getRecommendedRooms(game) {
  try {
    if (!window.SethEyeAPI) return [];
    const j = await SethEyeAPI.boards(game || (session && session.game) || 'golden-seth');
    const list = (j && j.composite) || [];
    return list.filter(c => c && c.machineNum != null).slice(0, 6).map(c => ({ room: String(c.machineNum), score: '分 ' + c.score }));
  } catch (e) { return []; }
}
// ===== 四榜：綜合分數(composite) / 爆分榜(volatility) / 精品排行(premium,花幣解鎖) / 最高免遊未開(freegame,聖甲之心助手端待提供) =====
const BOARD_META = {
  composite: { name: '綜合分數', scoreLabel: '綜合分數', color: '#7fdc8f' },
  volatility: { name: '爆分榜', scoreLabel: '爆發分數', color: '#ff9d5c' },
  premium: { name: '精品排行', scoreLabel: '精品分數', color: '#ffd86b' },
  freegame: { name: '免遊未開', scoreLabel: '最高未開', color: '#9fb8ff' },
};
let _boards = null, _curBoard = 'composite', _passTimer = null;
function fmtInt(n) { return Math.round(Number(n) || 0).toLocaleString('en-US'); }   // 千分位逗號
function fmtUpd(u) {   // 更新時間 HH:MM；容錯 number(秒/毫秒)/ISO字串/空→現在時間
  let d;
  if (u == null || u === 0) d = new Date();
  else if (typeof u === 'number') d = new Date(u < 1e12 ? u * 1000 : u);
  else d = new Date(u);
  if (isNaN(d.getTime())) d = new Date();
  return String(d.getHours()).padStart(2, '0') + ':' + String(d.getMinutes()).padStart(2, '0');
}

async function loadRecommended() {
  const box = $('recommend'); if (!box) return;
  bindBoardTabs();
  setBoardTabActive(_curBoard);
  box.innerHTML = '<span style="color:#7a6a48;font-size:13px">載入中…</span>';
  try {
    if (!window.SethEyeAPI) throw new Error('SethEyeAPI 未載入（index.html 沒載到 seth-eye-api.js）');
    const game = session ? session.game : 'golden-seth';
    _boards = await SethEyeAPI.boards(game);
    const ut = $('updTime'); if (ut) ut.textContent = '更新 ' + fmtUpd(_boards && _boards.updatedAt);
    renderBoard(_curBoard);
  } catch (e) {
    if (window.SethErr) { var info = SethErr.handle('BOARD', e, errCtx()); box.innerHTML = '<span style="color:#ff8c8c;font-size:12px">⚠️ 榜單載入失敗：' + info.human + '</span> <a href="#" onclick="SethErr.showLog();return false;" style="color:#9c8a66;font-size:11px;text-decoration:underline">診斷碼 ' + info.code + '</a>'; }
    else box.innerHTML = '<span style="color:#ff6b6b;font-size:12px">⚠️ 榜單載入失敗：' + (e && e.message ? e.message : e) + '</span>';
  }
}

function bindBoardTabs() {
  document.querySelectorAll('#boardTabs .btab').forEach(b => {
    if (b._bound) return; b._bound = true;
    b.style.cssText = 'width:100%;padding:8px 2px;border-radius:9px;border:1px solid #5a4a2a;background:#1a140d;color:#9a8a68;font-size:12.5px;font-weight:700;cursor:pointer;white-space:nowrap;';
    b.onclick = () => { _curBoard = b.dataset.k; setBoardTabActive(_curBoard); renderBoard(_curBoard); };
  });
}
function setBoardTabActive(k) {
  document.querySelectorAll('#boardTabs .btab').forEach(b => {
    const on = b.dataset.k === k;
    b.style.background = on ? 'linear-gradient(180deg,#d9b85a,#a8842f)' : '#1a140d';
    b.style.color = on ? '#1a1206' : '#9a8a68';
    b.style.borderColor = on ? '#e8c878' : '#5a4a2a';
  });
}

function renderBoard(k) {
  const box = $('recommend'); if (!box) return;
  box.innerHTML = '';
  if (_passTimer) { clearInterval(_passTimer); _passTimer = null; }   // 切榜→停掉精品倒數計時
  // 免遊未開：聖甲之心助手端尚未提供此榜資料 → 佔位
  if (k === 'freegame') {
    const list = (_boards && _boards.freegame) || null;
    if (!list || !list.length) {
      box.innerHTML = '<span style="color:#9fb8ff;font-size:12px;line-height:1.6">🕒 「最高免遊未開」榜建置中<br>（需聖甲之心助手後台統計各台免遊未開局數，已提交需求）</span>';
      return;
    }
    return renderCards(list, k);
  }
  const list = (_boards && _boards[k]) || [];
  if (!list.length) { box.innerHTML = '<span style="color:#ffb86b;font-size:12px">此榜暫無資料</span>'; return; }
  renderCards(list, k);
}

function renderCards(list, k) {
  const box = $('recommend');
  const meta = BOARD_META[k] || {};
  const accent = '#49dcff';
  const scoreLabel = meta.scoreLabel || '報分';
  if (k === 'premium') renderPremiumUnlock(box);
  list.slice(0, 10).forEach((c, idx) => {
    const locked = k === 'premium' && (c.roomId == null || c.machineNum == null);
    const rtp = c.rtp != null ? c.rtp : c.todayRtp;
    const bet = c.bet != null ? c.bet : c.todayBet;
    const profitRaw = c.profit != null ? c.profit : c.todayPnl;
    const playerPnl = -(Number(profitRaw) || 0);
    const el = document.createElement('div');
    el.className = 'scarab-room-card' + (locked ? ' locked' : '');
    const score = k === 'freegame' ? (c.c0 != null ? c.c0 : c.score) : c.score;
    el.innerHTML =
      '<div class="src-rank">#' + String(idx + 1).padStart(2, '0') + '</div>' +
      '<div class="src-main"><small>機台</small><b>#' + (locked ? 'LOCK' : String(c.machineNum).padStart(4,'0')) + '</b><div class="src-mini">RTP ' + (rtp != null ? rtp + '%' : '—') + ' · 下注 ' + (bet != null ? fmtInt(bet) : '—') + '</div></div>' +
      '<div class="src-score"><small>' + scoreLabel + '</small><b>' + (score != null ? score : '—') + '</b><span style="white-space:nowrap;font-size:' + (profitRaw != null && String(Math.abs(playerPnl)).length>7 ? '7px' : '9px') + '">' + (profitRaw == null ? '資料分析中' : ((playerPnl >= 0 ? '+' : '') + fmtInt(playerPnl))) + '</span></div>' +
      '<div class="src-go">›</div>';
    if (locked) el.onclick = () => { $('err2').textContent = '精品排行尚未解鎖'; };
    else el.onclick = () => onPickRoom(c, k);
    box.appendChild(el);
  });
}

// 點卡片 → 彈窗確認進房（用 roomId 定位、免疫機台號漂移；machineNum 當 fallback 提示）
let pendingPick = null;   // {roomId, machineNum, board, boardName}
function onPickRoom(c, k) {
  const mnum = c.machineNum;
  const bn = (BOARD_META[k] && BOARD_META[k].name) || '';
  showConfirm(
    '你選擇的是 : <b style="color:#f0d68a;font-size:19px">#' + String(mnum).padStart(4, '0') + '</b><br>進入此房進行遊戲嗎？',
    () => { $('err2').textContent = ''; pendingPick = { roomId: c.roomId, machineNum: mnum, board: k, boardName: bn }; $('room').value = mnum; enterGame('pick'); },
    '確認進入'
  );
}

// 精品榜下方：未解鎖→提示+解鎖按鈕；已解鎖→剩餘時間倒數(remainSec 來自 passes API)
function renderPremiumUnlock(box) {
  if (_passTimer) { clearInterval(_passTimer); _passTimer = null; }
  const wrap = document.createElement('div');
  wrap.style.cssText = 'width:100%;padding:12px 14px;border-radius:12px;background:#241a0c;border:1px solid #6b5630;text-align:center;';
  box.appendChild(wrap);
  const fmt = (s) => Math.floor(s / 60) + ':' + String(s % 60).padStart(2, '0');
  const showUnlockBtn = () => {
    wrap.innerHTML = '<div style="font-size:13.5px;color:#ffd86b;margin-bottom:11px;line-height:1.6">✨ 精品排行 · 平均爆分率 <b style="color:#ffe9a0">+25~+40%</b></div>';
    const btn = document.createElement('button');
    btn.textContent = '🔓 花費 1 金幣解鎖十分鐘';
    btn.style.cssText = 'width:100%;min-height:48px;margin:0;border:0;border-radius:11px;background:linear-gradient(180deg,#ffd86b,#c79a3e);color:#2a1e08;font-size:15px;font-weight:800;';
    btn.onclick = onUnlockPremium;
    wrap.appendChild(btn);
  };
  const showCountdown = (sec) => {
    let remain = Math.max(0, Math.floor(sec));
    const paint = () => { wrap.innerHTML = '<div style="font-size:13.5px;color:#7fdc8f;line-height:1.7">✅ 精品排行已解鎖<br><span style="color:#ffd86b">剩餘 <b style="font-size:20px;color:#ffe9a0">' + fmt(remain) + '</b></span></div>'; };
    paint();
    // 代理版(AGENT_MODE)：倒數歸零→重置回 480 秒繼續倒(永遠倒數中、不跳回解鎖鈕，錄影體驗一致)；一般版歸零→回解鎖鈕。
    _passTimer = setInterval(() => { remain--; if (remain <= 0) { if (window.AGENT_MODE) { remain = 480; paint(); } else { clearInterval(_passTimer); _passTimer = null; showUnlockBtn(); } } else paint(); }, 1000);
  };
  showUnlockBtn();   // 預設先顯示解鎖按鈕
  SethEyeAPI.passes((session && session.game) || 'golden-seth').then(p => { if (p && p.gold && p.gold.active && p.gold.remainSec > 0) showCountdown(p.gold.remainSec); }).catch(function () {});   // 已開通→換成倒數
}

function onUnlockPremium() {
  showConfirm(
    '解鎖精品排行<br>花費 <b style="color:#ffd86b">1 枚通行證幣</b>，開放 <b style="color:#ffd86b">10 分鐘</b>查看完整機台號<br>確認解鎖？',
    async () => {
      $('err2').textContent = '解鎖中…';
      try {
        // 沒登入聖甲之心助手會員 → 用娛樂城同帳密自動登
        if (!SethEyeAPI.token) { let j; try { j = await SethEyeAPI.login(session.account, session.password); } catch (e) {} if (!j || !j.token) { $('err2').textContent = ''; showLineDialog((j && j.message) || '無法驗證聖甲之心資格，請聯繫客服', (j && j.lineUrl) || SETH_LINE); return; } }
        const r = await SethEyeAPI.buyPass('gold');   // 金牌榜扣金幣（銀牌另做）
        if (r && (r.success || r.alreadyActive)) {
          $('err2').textContent = r.alreadyActive ? '✅ 通行證已開通中' : '✅ 解鎖成功，10 分鐘內可看完整精品榜';
          if (r.gold != null) refreshCoins({ gold: r.gold, silver: r.silver }); loadRecommended();
        } else { $('err2').textContent = '⚠️ ' + ((r && r.error) || '解鎖失敗，請確認金幣餘額'); }   // ⑥ 餘額不足等 error 直接顯示
      } catch (e) { $('err2').textContent = '⚠️ 解鎖失敗：' + (e && e.message ? e.message : e); }
    },
    '確認解鎖', 'linear-gradient(180deg,#ffd86b,#c79a3e)'
  );
}

// 通用確認彈窗（你選擇的是.../確認取消）
function showConfirm(htmlLines, onOk, okText, okBg) {
  const old = document.getElementById('cpModal'); if (old) old.remove();
  const mask = document.createElement('div');
  mask.id = 'cpModal';
  mask.style.cssText = 'position:fixed;inset:0;background:rgba(0,0,0,.62);display:flex;align-items:center;justify-content:center;z-index:9999;padding:26px;';
  const boxEl = document.createElement('div');
  boxEl.style.cssText = 'background:linear-gradient(155deg,rgba(5,18,32,.985),rgba(2,8,16,.995));border:1px solid #49dcff;border-radius:20px;padding:22px 20px 18px;max-width:340px;width:100%;box-shadow:0 24px 70px rgba(0,0,0,.72),0 0 26px rgba(64,210,255,.12);clip-path:polygon(14px 0,100% 0,100% calc(100% - 14px),calc(100% - 14px) 100%,0 100%,0 14px);';
  boxEl.innerHTML = '<div style="font-size:15px;color:#eaf7ff;line-height:1.75;text-align:center;margin-bottom:20px;word-break:keep-all">' + htmlLines + '</div>'; 
  const row = document.createElement('div');
  row.style.cssText = 'display:flex;gap:10px;';
  const cancel = document.createElement('button');
  cancel.textContent = '取消';
  cancel.style.cssText = 'flex:1;min-height:46px;margin:0;border:1px solid #2b4e66;border-radius:12px;background:#071522;color:#c7dfed;font-size:15px;font-weight:800;';
  cancel.onclick = () => mask.remove();
  const ok = document.createElement('button');
  ok.textContent = okText || '確認';
  ok.style.cssText = 'flex:1;min-height:46px;margin:0;border:0;border-radius:12px;background:linear-gradient(135deg,#56e7ff,#6078ff);color:#03111d;font-size:15px;font-weight:900;';
  ok.onclick = () => { mask.remove(); if (onOk) onOk(); };
  row.appendChild(cancel); row.appendChild(ok);
  boxEl.appendChild(row);
  mask.appendChild(boxEl);
  document.body.appendChild(mask);
  mask.onclick = e => { if (e.target === mask) mask.remove(); };
}


