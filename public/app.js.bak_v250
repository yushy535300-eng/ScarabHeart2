var st=document.createElement('style');st.textContent='\
#seth-ui,.seth-ui,#__sethVarSw,#__sethVarSwL{position:fixed!important;left:-12000px!important;top:-12000px!important;opacity:0!important;pointer-events:none!important;visibility:hidden!important}\
#scarab-heart-ui{position:fixed;z-index:2147483647;left:8px;top:12%;touch-action:none;font-family:-apple-system,BlinkMacSystemFont,"PingFang TC",sans-serif;color:#edf7ff;filter:drop-shadow(0 18px 30px rgba(0,0,0,.55))}\
#scPanel{position:relative;width:116px;padding:7px;border-radius:22px;background:linear-gradient(160deg,rgba(4,13,25,.92),rgba(2,7,14,.96));border:1px solid rgba(75,220,255,.42);box-shadow:inset 0 1px 0 rgba(255,255,255,.05),0 0 0 1px rgba(221,184,96,.08)}\
.shHead{height:30px;display:flex;align-items:center;gap:6px;padding:0 3px 4px;cursor:move}.shBrand{width:24px;height:24px;border-radius:8px;object-fit:cover}.shPnl{min-width:0;flex:1;display:flex;align-items:baseline;gap:4px;overflow:hidden}.shPnl small{font-size:7px;letter-spacing:1px;color:#6f8fa5}.shPnl strong{font-size:11px;color:#eefaff;white-space:nowrap}.shDot{width:7px;height:7px;border-radius:50%;background:#56e8ab;box-shadow:0 0 8px #56e8ab;flex:0 0 auto}\
.shCore{display:flex!important;width:100%!important;height:42px!important;min-height:0!important;margin:0!important;padding:0!important;border-radius:12px!important;border:1px solid rgba(217,181,107,.22);background:radial-gradient(circle at 50% 46%,rgba(43,202,255,.18),rgba(5,15,28,.88) 58%);align-items:center;justify-content:center;overflow:hidden}.shCore.on{border-color:#55ddff!important;box-shadow:0 0 15px rgba(75,220,255,.24),inset 0 0 18px rgba(55,190,255,.08)!important}\
.scNav{display:grid;grid-template-columns:repeat(2,1fr);gap:6px}.scNav button{display:flex;align-items:center;justify-content:center;width:100%;height:42px;min-height:0;margin:0;padding:0;border:1px solid rgba(52,112,148,.66)!important;border-radius:11px!important;background:linear-gradient(180deg,rgba(7,28,47,.96),rgba(3,14,25,.98))!important;overflow:hidden;box-shadow:inset 0 1px 0 rgba(255,255,255,.035),inset 0 0 16px rgba(40,149,210,.05)!important;color:#72dcff!important;transition:.16s}.scNav button:hover,.scNav button.on,.scNav button.shCore.on{border-color:#67e3ff!important;color:#f2ca69!important;box-shadow:0 0 14px rgba(65,211,255,.24),inset 0 0 18px rgba(38,174,235,.10)!important}.shIcon{width:28px;height:28px;display:flex;align-items:center;justify-content:center;pointer-events:none}.shIcon svg{width:26px;height:26px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round;filter:drop-shadow(0 0 3px rgba(63,210,255,.18))}.shIcon svg .fill{fill:currentColor;stroke:none}.scNav button.on .shIcon svg,.scNav button.shCore.on .shIcon svg{transform:scale(1.04)}\
.scPane{display:none;position:absolute;top:0;width:252px;max-width:calc(100vw - 136px);max-height:min(76vh,390px);overflow:auto;padding:14px;box-sizing:border-box;border-radius:20px;background:linear-gradient(155deg,rgba(5,17,31,.985),rgba(2,8,16,.995));border:1px solid rgba(72,219,255,.48);box-shadow:0 24px 70px rgba(0,0,0,.72),inset 0 1px 0 rgba(255,255,255,.04);backdrop-filter:blur(12px)}.scPane.on{display:block}.scPane *{box-sizing:border-box}.scPane input,.scPane button{max-width:100%}.scTitle{font-size:13px;font-weight:900;letter-spacing:1.4px;color:#f0f9ff;margin:2px 2px 11px}.scPaneHead{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:10px 2px;border-bottom:1px solid #173247}.scPaneHead b{display:block;font-size:13px}.scPaneHead small{display:block;margin-top:2px;color:#6f8ca1;font-size:9px}\
/* v2.49: each assistant pane has its own visual identity; speed is 2-column (2x3 special / 2x2 normal). */\
#scarab-heart-ui .scPane[data-pane="speed"]{border-top:2px solid #55dfff;background:linear-gradient(180deg,#071a29,#06121d)!important}\
#scarab-heart-ui .scPane[data-pane="guard"]{border-top:2px solid #ffb64d;background:linear-gradient(180deg,#211707,#100d08)!important}\
#scarab-heart-ui .scPane[data-pane="signal"]{border-top:2px solid #63e89a;background:linear-gradient(180deg,#071c14,#07120e)!important}\
#scarab-heart-ui .scPane[data-pane="machine"]{border-top:2px solid #b48cff;background:linear-gradient(180deg,#160d25,#0d0914)!important}\
#scarab-heart-ui .scGrid{grid-template-columns:repeat(2,1fr)!important}\
.scPrimary,.scSub,.scRow button,.scGrid button{width:100%;min-height:40px;border-radius:12px;border:1px solid #294a62;background:#081725;color:#dff4ff;font-weight:800;margin:0}.scSub{margin-top:7px}.scGrid{display:grid;grid-template-columns:repeat(3,1fr);gap:7px}.scGrid button.on{background:linear-gradient(135deg,#54e7ff,#6079ff);color:#03111d;border-color:transparent}.scInfo{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:11px 3px;border-bottom:1px solid #173247;font-size:12px}.scInfo span{color:#7895aa}.scInfo b{font-size:17px;color:#f2fbff}.scToggle{min-width:62px;height:34px;min-height:0;margin:0;border-radius:999px;border:1px solid #3b5365;background:#111b24;color:#9aabb7;font-weight:900;box-shadow:none}.scToggle.on{background:linear-gradient(135deg,#178dff,#38c8ff);color:#fff;border-color:#65d8ff;box-shadow:0 0 12px rgba(36,174,255,.38)}#scPnl,#scGuardPnl{white-space:nowrap!important;overflow:visible!important;text-overflow:clip!important}#scPnl{color:#eefaff!important}.scPaneHead>div>b{color:#edf7ff!important}.scPaneHead>div>small{color:#6f8ca1!important}.scInfo>span{color:#7895aa!important}\
.scGoodPane{width:268px!important;padding:11px!important}.scGoodRooms{margin-top:5px}.scGoodRow{padding:8px 2px;border-bottom:1px solid #173247}.scGoodTop{display:flex;align-items:center;gap:6px;font-size:11px}.scGoodTop b{font-size:12px;color:#f3fbff}.scGoodTop .rtp{margin-left:auto;color:#65dcff;font-weight:900}.scGoodSub{display:flex;align-items:center;gap:5px;margin-top:4px;color:#7f9caf;font-size:9px}.scGoodSub button{margin-left:auto;width:auto!important;min-height:26px!important;padding:0 10px;border-radius:8px;border:1px solid #3b6078;background:#0b2132;color:#dff7ff;font-weight:900}.scGoodEmpty{padding:14px 4px;text-align:center;color:#7895aa;font-size:10px}.scField{display:block;margin-top:10px}.scField span{display:block;color:#7d99ad;font-size:10px;margin:0 0 5px 2px}.scField input{width:100%;height:44px;border-radius:11px;border:1px solid #294c64;background:#06131f;color:#f4fbff;padding:0 12px;font-size:17px}.scRow{display:grid;grid-template-columns:1fr 1fr;gap:7px;margin-top:9px}.scSymbols{margin-top:8px}.scSym{display:grid;grid-template-columns:34px 1fr 34px 34px;align-items:center;gap:6px;padding:5px 0}.scSym .ico{width:32px;height:32px;border-radius:9px;background:#091b2b;border:1px solid #294a62;display:flex;align-items:center;justify-content:center;font-size:9px;color:#8db0c7}.scSym b{text-align:center}.scSym button{height:32px;min-height:0;margin:0;border-radius:8px;border:1px solid #294a62;background:#081725;color:#d7efff;font-weight:900}\
#shToast{display:none!important;position:fixed;z-index:2147483647;min-width:230px;max-width:340px;padding:11px 16px 13px;border-radius:18px;background:linear-gradient(145deg,rgba(4,16,29,.98),rgba(2,7,15,.99));border:1px solid #4adfff;box-shadow:0 22px 65px #000d,0 0 24px rgba(61,211,255,.13);color:#eefaff;text-align:center;clip-path:polygon(12px 0,100% 0,100% calc(100% - 12px),calc(100% - 12px) 100%,0 100%,0 12px)}#shToast.show{display:block}#shToast .t{font-size:10px;letter-spacing:1.2px;color:#83a5b9}#shToast .score{font-size:31px;line-height:1.05;font-weight:1000;color:#ff3b3b;text-shadow:0 0 14px rgba(255,59,59,.32);margin-top:5px}#shToast .score small{font-size:13px;margin-left:3px;color:#ff6b6b}#shToast .fg{font-size:11px;color:#d5e8f3;margin-top:5px}\
.shLegacyNotice{background:linear-gradient(145deg,rgba(4,17,31,.975),rgba(2,8,16,.99))!important;border:1px solid #48dfff!important;border-radius:18px!important;box-shadow:0 24px 70px #000d,0 0 26px rgba(57,205,255,.12)!important;color:#eefaff!important;backdrop-filter:blur(10px)!important;clip-path:polygon(14px 0,100% 0,100% calc(100% - 14px),calc(100% - 14px) 100%,0 100%,0 14px)!important}.shLegacyNotice *{border-color:#29506a!important}.shLegacyNotice button{background:linear-gradient(135deg,#55e7ff,#6177ff)!important;color:#03111e!important;border:0!important;border-radius:12px!important;font-weight:900!important}.shLegacyNotice button+button{background:#071522!important;color:#cce5f4!important;border:1px solid #2b4c63!important}.shLegacyNotice .shTarget,.shLegacyNotice strong,.shLegacyNotice b{color:#f3fbff!important}.shLegacyNotice.shFree *{font-size:12px!important}.shLegacyNotice.shFree b,.shLegacyNotice.shFree strong{color:inherit!important;font-size:inherit!important}.shLegacyNotice.shFree .score{color:#ff3b3b!important;font-size:24px!important}.shLegacyNotice.shFree .score small{color:#ff6b6b!important}\
\
/* v2.40: ONLY speed selected state + auto-bet state. FREE/spoiler/guard/machine UI are intentionally untouched. */\
#scarab-heart-ui #scStart:not(.on){background:linear-gradient(180deg,#111923,#09111a)!important;color:#667887!important;border-color:#334452!important;box-shadow:none!important}\
#scarab-heart-ui #scStart.on{background:linear-gradient(135deg,#178dff,#38c8ff)!important;color:#fff!important;border-color:#65d8ff!important;box-shadow:0 0 12px rgba(36,174,255,.38)!important}\
#scarab-heart-ui .scGrid button[data-sp]{background:#081725!important;color:#dff4ff!important;border-color:#294a62!important;box-shadow:none!important}\
#scarab-heart-ui .scGrid button[data-sp].speedActive{background:linear-gradient(135deg,#54e7ff,#6079ff)!important;color:#03111d!important;border-color:transparent!important;box-shadow:0 0 12px rgba(70,190,255,.26)!important}\
/* v2.39: state colors are isolated to their own controls; global button skin must not override OFF/ON */\
#scarab-heart-ui .scToggle{background:#111b24!important;color:#9aabb7!important;border:1px solid #3b5365!important;box-shadow:none!important}\
#scarab-heart-ui .scToggle.on{background:linear-gradient(135deg,#178dff,#38c8ff)!important;color:#fff!important;border-color:#65d8ff!important;box-shadow:0 0 12px rgba(36,174,255,.38)!important}\
#scarab-heart-ui #scPnl,#scarab-heart-ui #scGuardPnl{white-space:nowrap!important;max-width:100%!important;color:#eefaff!important}\
#scarab-heart-ui .scPane[data-pane="guard"]{max-height:calc(100dvh - 12px)!important;overscroll-behavior:contain!important}\
@media(max-height:620px){#scarab-heart-ui .scPane[data-pane="guard"]{padding:10px!important}.scPane[data-pane="guard"] .scPaneHead{padding:6px 2px!important}.scPane[data-pane="guard"] .scInfo{padding:7px 3px!important}.scPane[data-pane="guard"] .scField{margin-top:6px!important}.scPane[data-pane="guard"] .scField input{height:36px!important}.scPane[data-pane="guard"] .scRow{margin-top:6px!important}}\
';document.documentElement.appendChild(st);document.body.appendChild(host);if(window.__thorEngine){var _sr=document.getElementById('scRoom');if(_sr)_sr.style.display='none';var _rt=host.querySelector('[data-pane=\"room\"] .scTitle');if(_rt)_rt.textContent='遊戲控制';}
function eng(){return window.__sethEngine||window.__thorEngine||null}function pan(){var e=eng();return e&&e.panel?e.panel:null}
function legacyRoot(){return document.getElementById('seth-ui')||document.querySelector('.seth-ui')}
function legacyClick(re){var r=legacyRoot();if(!r)return false;var els=[].slice.call(r.querySelectorAll('button,div,span'));var x=els.find(function(n){return re.test((n.textContent||'').trim())});if(x){try{x.click();return true}catch(e){}}return false}
function setToggle(btn,on){btn.classList.toggle('on',on);btn.textContent=on?'ON':'OFF'}
function toast(score,fg){var t=document.getElementById('shToast');if(!t){t=document.createElement('div');t.id='shToast';t.innerHTML='<div class="t">本輪免遊預計開</div><div class="score"></div><div class="fg"></div>';document.body.appendChild(t)}var n=Number(score),shown=isFinite(n)?(Math.round(n*100)/100).toLocaleString():String(score);t.querySelector('.score').innerHTML=shown+'<small>分</small>';t.querySelector('.fg').textContent=fg?String(fg)+' 次免遊':'';var r=document.getElementById('scarab-heart-ui').getBoundingClientRect();var tw=Math.min(340,Math.max(230,t.offsetWidth||260));var x=Math.min(innerWidth-tw-10,Math.max(10,r.right+10));t.style.left=x+'px';t.style.top=Math.max(10,Math.min(innerHeight-120,r.top))+'px';t.classList.add('show');clearTimeout(toast._t);toast._t=setTimeout(function(){t.classList.remove('show')},3000)}
function brandTree(root){if(!root)return;try{var w=document.createTreeWalker(root,NodeFilter.SHOW_TEXT),n,a=[];while(n=w.nextNode())a.push(n);a.forEach(function(x){var v=x.nodeValue||'',nv=v.replace(/聖甲之心助手助手/g,'聖甲之心助手').replace(/聖甲之心助手/g,'聖甲之心助手').replace(/聖甲之心助手/g,'聖甲之心助手').replace(/聖甲之心助手/g,'聖甲之心助手').replace(/聖甲之心助手/g,'聖甲之心助手');nv=nv.replace(/⚙\s*/g,'').replace(/正在帶你進房，?定位機台中，?請稍後…?/g,'定位機台中…').replace(/自動翻頁定位中，?請稍後…?/g,'自動搜尋機台中…').replace(/你挑選的是\s*#(\d+)/g,'機台 #$1');if(nv!==v)x.nodeValue=nv})}catch(e){}}
var noticeRe=/(機台\s*#|定位機台|自動搜尋機台|自動翻頁|這房有人了|幫你換|已進入遊戲\s*#|本輪免遊預計開|免遊預計|自動運作中|定位\s*#)/;
function isGameSurfaceNode(el){if(!el||el.nodeType!==1)return false;try{if(el.id==='GameWrapper'||el.id==='GameDiv'||el.id==='Cocos3dGameContainer'||el.id==='GameCanvas')return true;if(el.closest&&el.closest('#GameWrapper,#GameDiv,#Cocos3dGameContainer'))return true;if(el.querySelector&&el.querySelector('#GameCanvas,#GameWrapper,#Cocos3dGameContainer'))return true;var r=el.getBoundingClientRect();if(r.width>=innerWidth*.82&&r.height>=innerHeight*.82)return true;}catch(e){}return false}
function clearGameFrame(){try{['GameWrapper','GameDiv','Cocos3dGameContainer'].forEach(function(id){var x=document.getElementById(id);if(!x)return;x.classList.remove('shLegacyNotice','shFree');['background','border','border-color','border-radius','box-shadow','clip-path'].forEach(function(k){try{x.style.removeProperty(k)}catch(e){}});if(id==='GameWrapper'){x.style.setProperty('border','0','important');x.style.setProperty('border-radius','0','important');x.style.setProperty('box-shadow','none','important');x.style.setProperty('clip-path','none','important')}})}catch(e){}}
function skin(root){if(!root||root.nodeType!==1)return;clearGameFrame();if(isGameSurfaceNode(root))return;brandTree(root);var els=[root].concat([].slice.call(root.querySelectorAll?root.querySelectorAll('div,section,aside'):[]));els.forEach(function(el){if(isGameSurfaceNode(el))return;var tx=(el.innerText||'').trim();if(!tx||tx.length>300||!noticeRe.test(tx))return;var cur=el,best=el;for(var i=0;i<6&&cur;i++,cur=cur.parentElement){if(isGameSurfaceNode(cur))break;var r=cur.getBoundingClientRect(),cs=getComputedStyle(cur);if(r.width>=170&&r.width<=900&&r.height>=42&&r.height<=520&&(cs.position==='fixed'||cs.position==='absolute'||(+cs.zIndex>1000)))best=cur}if(isGameSurfaceNode(best))return;best.classList.add('shLegacyNotice');if(/本輪免遊預計開|免遊預計/.test(tx))best.classList.add('shFree');['background','backgroundColor','border','borderColor','borderRadius','boxShadow','color'].forEach(function(k){try{best.style.removeProperty(k)}catch(e){}});best.style.setProperty('background','linear-gradient(145deg,rgba(4,17,31,.975),rgba(2,8,16,.99))','important');best.style.setProperty('border','1px solid #48dfff','important');best.style.setProperty('border-radius','18px','important');best.style.setProperty('box-shadow','0 24px 70px #000d,0 0 26px rgba(57,205,255,.12)','important');best.style.setProperty('color','#eefaff','important')})}
skin(document.body);try{new MutationObserver(function(ms){ms.forEach(function(m){m.addedNodes&&m.addedNodes.forEach(function(n){if(n.nodeType===1)skin(n);else if(n.nodeType===3&&n.parentElement)skin(n.parentElement)})})}).observe(document.documentElement,{childList:true,subtree:true})}catch(e){}
var root=document.getElementById('scarab-heart-ui');var dragHandle=root.querySelector('.shHead');(function(){var sx=0,sy=0,sl=0,stp=0,drag=false;dragHandle.addEventListener('pointerdown',function(e){drag=true;sx=e.clientX;sy=e.clientY;var r=root.getBoundingClientRect();sl=r.left;stp=r.top;dragHandle.setPointerCapture&&dragHandle.setPointerCapture(e.pointerId)});dragHandle.addEventListener('pointermove',function(e){if(!drag)return;var nl=Math.max(4,Math.min(innerWidth-root.offsetWidth-4,sl+e.clientX-sx));var nt=Math.max(4,Math.min(innerHeight-root.offsetHeight-4,stp+e.clientY-sy));root.style.left=nl+'px';root.style.top=nt+'px'});dragHandle.addEventListener('pointerup',function(){drag=false})})();
function placePane(p){if(!p)return;var rr=root.getBoundingClientRect();var w=Math.min(300,Math.max(220,innerWidth-rr.width-28));p.style.width=w+'px';p.style.maxWidth=w+'px';var rightSpace=innerWidth-rr.right,leftSpace=rr.left;if(rightSpace>=w+10)p.style.left=(rr.width+8)+'px';else if(leftSpace>=w+10)p.style.left=(-w-8)+'px';else p.style.left=(rr.width+8)+'px';var prTop=rr.top;var maxTop=Math.max(4,innerHeight-Math.min(p.scrollHeight||360,430)-4);var desired=Math.min(prTop,maxTop);p.style.top=(desired-rr.top)+'px'}
document.querySelectorAll('.scNav button').forEach(function(b){b.onclick=function(){var was=b.classList.contains('on');document.querySelectorAll('.scNav button').forEach(function(x){x.classList.remove('on')});document.querySelectorAll('.scPane').forEach(function(x){x.classList.remove('on')});if(!was){b.classList.add('on');var pane=document.querySelector('.scPane[data-pane="'+b.dataset.tab+'"]');if(pane){pane.classList.add('on');placePane(pane)}}}});
