{
  "manifest_version": 3,
  "name": "聖甲之心遊戲引擎",
  "description": "在官方 ATG／RSG 遊戲頁載入聖甲之心懸浮功能。",
  "version": "2.52.0",
  "minimum_chrome_version": "111",
  "icons": {
    "128": "icon.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.godeebxp.com/*",
        "https://*.rsgaming955.com/*",
        "https://*.rsgaming777.com/*",
        "https://*.royalgaming777.com/*",
        "https://*.tz6868.cc/*"
      ],
      "js": [
        "runtime/atg-engine-runtime.js",
        "runtime/thor-engine-runtime.js",
        "injector.js",
        "runtime/overlay-runtime.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN",
      "all_frames": false
    }
  ]
}
